# Load the dataset
data(chickwts)
# See first rows
head(chickwts)
# Quick structure
str(chickwts)
# Summary of feed groups
summary(chickwts$feed)
# Summary of weights
summary(chickwts$weight)
boxplot(weight ~ feed,
data = chickwts,
main = "Chicken Weight by Feed Type",
xlab = "Feed type",
ylab = "Weight at 6 weeks (g)",
col  = c("lightblue","lightgreen","pink","orange","yellow","violet"),
varwidth = TRUE,
notch = TRUE)
# Reset margins (important!)
par(mar = c(5, 4, 4, 2) + 0.1)
# Now run your boxplot
boxplot(weight ~ feed,
data = chickwts,
main = "Chicken Weight by Feed Type",
xlab = "Feed type",
ylab = "Weight at 6 weeks (g)",
col  = c("lightblue","lightgreen","pink","orange","yellow","violet"),
varwidth = TRUE,
notch = TRUE)
# Count chicks per feed type
feed_counts <- table(chickwts$feed)
# Create bar chart
barplot(feed_counts,
main = "Number of Chicks by Feed Type",
xlab = "Feed type",
ylab = "Number of chicks",
col = "skyblue",
border = "darkblue")
# Save boxplot
png("chickwts_boxplot.png", width = 800, height = 600)
boxplot(weight ~ feed, data = chickwts,
main = "Chicken Weight by Feed Type",
xlab = "Feed type",
ylab = "Weight at 6 weeks (g)",
col  = c("lightblue","lightgreen","pink","orange","yellow","violet"),
varwidth = TRUE,
notch = TRUE)
dev.off()
# Save bar chart
png("chickwts_barchart.png", width = 800, height = 600)
feed_counts <- table(chickwts$feed)
barplot(feed_counts,
main = "Number of Chicks by Feed Type",
xlab = "Feed type",
ylab = "Number of chicks",
col = "skyblue",
border = "darkblue")
dev.off()
