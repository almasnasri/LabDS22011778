# PLOT 1: BARCHART - Survivors by Class
surv_class <- table(titanic$Pclass, titanic$Survived)
barplot(surv_class,
main = "Titanic Survivors by Passenger Class",
xlab = "Class", ylab = "Count",
col = c("red", "green"),
legend.text = c("Died", "Survived"),
beside = TRUE)
# PLOT 2: BOXPLOT - Age by Survival
boxplot(Age ~ Survived, data = titanic,
main = "Titanic Age Distribution by Survival",
xlab = "Survived (0=Died, 1=Survived)",
ylab = "Age (years)",
col = c("red", "green"))
# Save both plots
png("titanic_barchart.png", width=800, height=600)
barplot(surv_class, col=c("red","green"), beside=TRUE,
main="Survivors by Class", legend.text=c("Died","Survived"))
dev.off()
png("titanic_boxplot.png", width=800, height=600)
boxplot(Age ~ Survived, data=titanic, col=c("red","green"),
main="Age by Survival")
dev.off()
